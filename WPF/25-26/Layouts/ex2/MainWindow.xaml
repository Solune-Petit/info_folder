<Window x:Class="ex2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ex2"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center">
            <TextBox Margin="10,0" Padding="30"/>
        </StackPanel>

        <Button Grid.Column="3" Grid.Row="0" Content="C" FontSize="48" Margin="10" Padding="10" Background="red" FontWeight="Bold" />


        <Button Grid.Column="0" Grid.Row="1" Content="1" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="1" Grid.Row="1" Content="2" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="2" Grid.Row="1" Content="3" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="3" Grid.Row="1" Content="+" FontSize="36" Margin="10" Padding="10" Background="Green" FontWeight="Bold"/>
        <Button Grid.Column="0" Grid.Row="2" Content="4" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="1" Grid.Row="2" Content="5" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="2" Grid.Row="2" Content="6" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="3" Grid.Row="2" Content="-" FontSize="36" Margin="10" Padding="10" Background="Green" FontWeight="Bold"/>
        <Button Grid.Column="0" Grid.Row="3" Content="7" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="1" Grid.Row="3" Content="8" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="2" Grid.Row="3" Content="9" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="3" Grid.Row="3" Content="/" FontSize="36" Margin="10" Padding="10" Background="Green" FontWeight="Bold"/>
        <Button Grid.Column="0" Grid.Row="4" Content="," FontSize="36" Margin="10" Padding="10" FontWeight="Bold" Background="#FFB2DAFF"/>
        <Button Grid.Column="1" Grid.Row="4" Content="0" FontSize="36" Margin="10" Padding="10" FontWeight="Bold"/>
        <Button Grid.Column="2" Grid.Row="4" Content="*" FontSize="36" Margin="10" Padding="10" FontWeight="Bold" Background="Green"/>
        <Button Grid.Column="3" Grid.Row="4" Content="=" FontSize="36" Margin="10" Padding="10" FontWeight="Bold" Background="Orange"/>
    </Grid>
</Window>
