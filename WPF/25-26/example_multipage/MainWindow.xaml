<Window x:Class="example_multipage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:example_multipage"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="#fad541">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Exemple Multipage" FontSize="50" FontWeight="Bold"></TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1">
            <Button x:Name="btnPage1" Content="Page 1" Width="Auto" Height="50" Background="Red"/>
            <Button x:Name="btnPage2" Content="Page 2" Width="Auto" Height="50" Background="Blue"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Height="Auto" Width="Auto" VerticalAlignment="Center">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </StackPanel>

    </Grid>


</Window>
